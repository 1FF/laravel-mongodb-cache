{
    "name": "1ff/laravel-mongodb-cache",
    "description": "A mongodb cache driver for laravel",
    "type": "library",
    "version": "2.11.2",
    "require": {
        "mongodb/laravel-mongodb": "^3.5",
        "illuminate/cache": "5.*|6.*"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Vihren Ganev",
            "email": "vihren@appsforfit.com"
        }
    ],
    "minimum-stability": "stable",
